(version 1)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.125mm))
)
(rule "Copper to edge clearance 1"
	# по максимуму
	(constraint edge_clearance (min 0.4mm))
)
(rule "Copper to hole clearance 1"
	(constraint hole_clearance (min 0.25mm))
)
(rule "Minimum thermal relief spoke count 1"
	(constraint min_resolved_spokes 4)
)
(rule "Minimum annular width 1"
	(constraint annular_width (min 0.15mm))
)
(rule "Hole to hole distance 1"
	(constraint hole_to_hole (min 0.2mm))
)
(rule "Minimum text height and thickness 1"
	(constraint text_height (min 1mm))
	(constraint text_thickness (min 0.15mm))
)
(rule "Silk to silk clearance 1"
	(constraint silk_clearance (min 0.1mm))
	(condition "L == 'F.SilkS'")
)
(rule "Silk to soldermask clearance 1"
	(constraint silk_clearance (min 0.1mm))
	(condition "L == 'F.Mask' || L == 'B.Mask'")
)
(rule "Minimum soldermask sliver 1"
	(constraint solder_mask_sliver (min 0.15mm))
)
(rule "Soldermask expansion 1"
	(constraint solder_mask_expansion (min 0.05mm))
)
